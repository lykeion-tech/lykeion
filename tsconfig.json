{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@lykeion/api": ["./apps/dashboard/src/coresearch/cowrite/lib/l2-api.ts"]
    }
  },
  "include": [
    "apps/dashboard/**/*.ts",
    "apps/dashboard/**/*.vue",
    "apps/web/**/*.ts",
    "apps/web/**/*.vue",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ]
}
