{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@lykeion/api": ["./apps/dashboard/src/coresearch/cowrite/lib/l2-api.ts"]
    }
  },
  "include": [
    "apps/dashboard/**/*.ts",
    "apps/dashboard/**/*.vue",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "apps/dashboard/src/views/ResourceView.vue",
    "apps/dashboard/src/components/AgentConfiguration.vue",
    "apps/dashboard/src/components/AgentPanels.vue",
    "apps/dashboard/src/components/AgentWork.vue",
    "apps/dashboard/src/components/CustomRuntime.vue",
    "apps/dashboard/src/components/ExecutionOptions.vue",
    "apps/dashboard/src/components/ResourceDetail.vue",
    "apps/dashboard/src/components/ResourceEditor.vue",
    "apps/dashboard/src/components/RuntimeDetail.vue",
    "apps/dashboard/src/components/TaskAuxiliary.vue",
    "apps/dashboard/src/components/TaskContextMenu.vue",
    "apps/dashboard/src/components/TaskWakeups.vue"
  ]
}
