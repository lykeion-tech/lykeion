(version 1)
(deny default)
(allow process-fork process-exec)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow file-read* (literal "/") (subpath "/usr") (subpath "/bin") (subpath "/sbin") (subpath "/System") (subpath "/Library") (subpath "/private/etc") (subpath "/private/var/db/timezone") (literal "/private/var/select/sh") (literal "/dev/null") (literal "/dev/zero") (literal "/dev/random") (literal "/dev/urandom") (literal "/dev/tty") (literal "/dev/dtracehelper") (subpath "/dev/fd") (subpath "/opt/homebrew"))
(allow file-ioctl (literal "/dev/dtracehelper"))
(allow file-read-metadata (literal "/etc") (literal "/tmp") (literal "/var") (literal "/opt") (literal "/private/var/db") (literal "/private/var") (literal "/private") (literal "/private/var/select"))
(deny file-read* (subpath "/opt/homebrew/var") (subpath "/usr/local/var"))
(allow file-write* (literal "/dev/null") (literal "/dev/tty") (subpath "/dev/fd") (literal "/dev/dtracehelper"))
(allow ipc-posix-sem)
(allow ipc-posix-shm*)
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.system.opendirectoryd.membership") (global-name "com.apple.logd") (global-name "com.apple.system.notification_center") (global-name "com.apple.SystemConfiguration.configd") (global-name "com.apple.trustd.agent"))
(allow system-socket)
(allow network-outbound (remote ip))
(allow network-inbound network-bind (local ip))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
