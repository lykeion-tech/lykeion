{
  "name": "lykeion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/dashboard/vite.config.ts --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --config apps/dashboard/vite.config.ts && tsc -p apps/desktop/tsconfig.json",
    "typecheck": "vue-tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "vitest run tests/research.test.ts tests/control-client.test.ts tests/native-bridge.test.ts tests/session-vault.test.ts tests/live-selection.test.ts --maxWorkers=1",
    "test:e2e": "playwright test --workers=1",
    "desktop": "electron apps/desktop/out/main.js",
    "desktop:dev": "LYKEION_RENDERER_URL=http://127.0.0.1:1430 electron apps/desktop/out/main.js",
    "contracts:generate": "python3 scripts/generate-contracts.py && openapi-typescript contracts/control.openapi.json -o packages/api-client/src/generated/control.ts",
    "contracts:check": "node scripts/check-contracts.mjs && python3 scripts/check-api-design.py",
    "test:backend": "cd backend && go test -race ./...",
    "contracts:drift": "node scripts/check-generated.mjs",
    "test:backend:integration": "python3 scripts/test-backend.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "emojibase-data": "^17.0.0",
    "lottie-web": "^5.13.0",
    "vue": "3.5.43",
    "vue-router": "^4.6.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "electron": "44.7.0",
    "openapi-typescript": "7.10.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.0"
  }
}
