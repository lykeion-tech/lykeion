{
  "name": "lykeion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/dashboard/vite.config.ts --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build --config apps/dashboard/vite.config.ts && tsc -p apps/desktop/tsconfig.json",
    "typecheck": "vue-tsc --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "test": "vitest run apps/dashboard/src/lib/backends.test.ts tests/state.test.ts tests/lib.test.ts tests/api.test.ts tests/realtime.test.ts tests/studies.test.ts tests/mock-layer.test.ts tests/refinements.test.ts tests/transcript.test.ts tests/tool-steps.test.ts tests/drafts.test.ts --config apps/dashboard/vite.config.ts --root . --maxWorkers=1",
    "test:e2e": "playwright test --workers=1",
    "desktop": "electron apps/desktop/out/main.js",
    "desktop:dev": "LYKEION_RENDERER_URL=http://127.0.0.1:1430 electron apps/desktop/out/main.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/vue": "^1.55.0",
    "@tanstack/vue-query": "5.104.0",
    "emojibase-data": "^17.0.0",
    "lottie-web": "^5.13.0",
    "markdown-it": "15.0.2",
    "shiki": "4.3.1",
    "vue": "3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "44.7.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.2.0"
  }
}
