{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "components": {
    "schemas": {
      "ID": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{2,127}$"
      },
      "Revision": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$",
        "maxLength": 20
      },
      "Hash": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "Ref": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "sha256": {
            "$ref": "#/components/schemas/Hash"
          }
        },
        "required": [
          "kind",
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "Target": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workspace",
              "programme",
              "inquiry",
              "request",
              "document",
              "membership",
              "invitation"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/ID"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "retryable": {
            "type": "boolean"
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "maxItems": 1000
          },
          "current_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "schema_version",
          "code",
          "message",
          "request_id",
          "retryable",
          "violations",
          "current_versions"
        ],
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "command_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "blocked",
              "failed",
              "superseded"
            ]
          },
          "target_ref": {
            "$ref": "#/components/schemas/Target"
          },
          "accepted_at": {
            "type": "string",
            "format": "date-time"
          },
          "result_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          },
          "decision_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "failure": {
            "$ref": "#/components/schemas/Problem"
          },
          "event_cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "schema_version",
          "id",
          "command_name",
          "state",
          "target_ref",
          "accepted_at",
          "result_refs",
          "event_cursor"
        ],
        "additionalProperties": false
      },
      "Member": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "user_id": {
            "$ref": "#/components/schemas/ID"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/ID"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "access_role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member",
              "viewer"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "active",
              "removed"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "id",
          "user_id",
          "workspace_id",
          "display_name",
          "access_role",
          "state",
          "revision"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "id",
          "name",
          "revision"
        ],
        "additionalProperties": false
      },
      "Programme": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/ID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "profile_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "policy_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          },
          "budget_ceiling": {
            "$ref": "#/components/schemas/BudgetCeiling"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "name",
          "objective",
          "revision",
          "profile_ref",
          "policy_refs",
          "budget_ceiling"
        ],
        "additionalProperties": false
      },
      "BudgetCeiling": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "model_microunits": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "cpu_milliseconds": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "gpu_milliseconds": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "elapsed_milliseconds": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "currency",
          "model_microunits",
          "cpu_milliseconds",
          "gpu_milliseconds",
          "elapsed_milliseconds"
        ],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "user_id": {
            "$ref": "#/components/schemas/ID"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "csrf_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "csrf_token",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "api_version": {
            "const": "1"
          },
          "workspace_protocol": {
            "const": "lykeion.workspace.v1"
          },
          "worker_protocol": {
            "const": "lykeion.worker.v1"
          },
          "supported_commands": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 1000
          },
          "supported_features": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 1000
          }
        },
        "required": [
          "api_version",
          "workspace_protocol",
          "worker_protocol",
          "supported_commands",
          "supported_features"
        ],
        "additionalProperties": false
      },
      "Attribution": {
        "type": "object",
        "properties": {
          "initiator_id": {
            "$ref": "#/components/schemas/ID"
          },
          "authorizer_id": {
            "$ref": "#/components/schemas/ID"
          },
          "actor_id": {
            "$ref": "#/components/schemas/ID"
          },
          "actor_kind": {
            "type": "string",
            "enum": [
              "human",
              "service",
              "agent"
            ]
          },
          "delegation_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "initiator_id",
          "authorizer_id",
          "actor_id",
          "actor_kind",
          "delegation_refs"
        ],
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "subject_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          },
          "operation_id": {
            "$ref": "#/components/schemas/ID"
          },
          "causation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "correlation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "attribution_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "payload": {
            "type": "object",
            "properties": {
              "changed_fields": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "maxItems": 1000
              }
            },
            "required": [
              "changed_fields"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "subject_ref",
          "revision",
          "recorded_at",
          "operation_id",
          "causation_id",
          "correlation_id",
          "attribution_ref",
          "payload"
        ],
        "additionalProperties": false
      },
      "Invitation": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/ID"
          },
          "recipient": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "requested_role": {
            "type": "string",
            "enum": [
              "admin",
              "member",
              "viewer"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "revoked",
              "expired"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "id",
          "workspace_id",
          "recipient",
          "requested_role",
          "state",
          "expires_at",
          "revision"
        ],
        "additionalProperties": false
      },
      "MembershipDecision": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "workspace_id": {
            "$ref": "#/components/schemas/ID"
          },
          "requester_id": {
            "$ref": "#/components/schemas/ID"
          },
          "responder_id": {
            "$ref": "#/components/schemas/ID"
          },
          "member_id": {
            "$ref": "#/components/schemas/ID"
          },
          "action": {
            "type": "string",
            "enum": [
              "change-access",
              "transfer-owner"
            ]
          },
          "requested_role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member",
              "viewer"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected",
              "expired"
            ]
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "subject_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          }
        },
        "required": [
          "id",
          "workspace_id",
          "requester_id",
          "responder_id",
          "member_id",
          "action",
          "requested_role",
          "state",
          "revision",
          "expires_at",
          "subject_versions"
        ],
        "additionalProperties": false
      },
      "AccessGrant": {
        "type": "object",
        "properties": {
          "programme_id": {
            "$ref": "#/components/schemas/ID"
          },
          "user_id": {
            "$ref": "#/components/schemas/ID"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "comment",
                "edit",
                "manage-access"
              ]
            },
            "maxItems": 1000
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          }
        },
        "required": [
          "programme_id",
          "user_id",
          "capabilities",
          "revision"
        ],
        "additionalProperties": false
      },
      "DomainProfile": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "domain": {
            "const": "computational"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "name",
          "domain",
          "description"
        ],
        "additionalProperties": false
      },
      "GatePolicyRule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "require": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "advance",
              "block",
              "route",
              "escalate"
            ]
          },
          "destination": {
            "type": "string",
            "enum": [
              "Backlog",
              "Grounding",
              "Hypotheses",
              "Experimentation",
              "Validation",
              "Reporting",
              "Done"
            ]
          }
        },
        "required": [
          "id",
          "require",
          "outcome"
        ],
        "additionalProperties": false
      },
      "GatePolicy": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "required": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/GatePolicyRule"
            }
          }
        },
        "required": [
          "version",
          "required",
          "rules"
        ],
        "additionalProperties": false
      },
      "GrantPlan": {
        "type": "object",
        "properties": {
          "subject_ref": {
            "$ref": "#/components/schemas/Ref"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "user_id": {
                  "$ref": "#/components/schemas/ID"
                },
                "capabilities": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "read",
                      "comment",
                      "edit",
                      "manage-access"
                    ]
                  }
                }
              },
              "required": [
                "user_id",
                "capabilities"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "subject_ref",
          "changes"
        ],
        "additionalProperties": false
      },
      "ConfigManifest": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "const": "configuration.json"
                },
                "upload_ref": {
                  "$ref": "#/components/schemas/Ref"
                }
              },
              "required": [
                "path",
                "upload_ref"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "files"
        ],
        "additionalProperties": false
      },
      "UploadReservation": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "maximum_bytes": {
            "const": 65536
          },
          "part_count": {
            "const": 1
          }
        },
        "required": [
          "id",
          "maximum_bytes",
          "part_count"
        ],
        "additionalProperties": false
      },
      "UploadPartReceipt": {
        "type": "object",
        "properties": {
          "upload_id": {
            "$ref": "#/components/schemas/ID"
          },
          "sha256": {
            "$ref": "#/components/schemas/Hash"
          }
        },
        "required": [
          "upload_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "ArtifactRecord": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ID"
          },
          "revision": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "sha256": {
            "$ref": "#/components/schemas/Hash"
          },
          "manifest": {
            "$ref": "#/components/schemas/ConfigManifest"
          }
        },
        "required": [
          "id",
          "revision",
          "sha256",
          "manifest"
        ],
        "additionalProperties": false
      },
      "ArtifactSubmitCommand": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "expected_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          },
          "payload": {
            "type": "object",
            "properties": {
              "upload_receipt_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Ref"
                },
                "maxItems": 1000
              },
              "manifest_candidate": {
                "$ref": "#/components/schemas/ConfigManifest"
              },
              "authored_kind": {
                "type": "string",
                "enum": [
                  "domain-profile",
                  "gate-policy",
                  "grant-changes"
                ]
              }
            },
            "required": [
              "upload_receipt_refs",
              "manifest_candidate",
              "authored_kind"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "target",
          "expected_versions",
          "payload"
        ],
        "additionalProperties": false
      },
      "AccessChangeCommand": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "expected_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          },
          "payload": {
            "type": "object",
            "properties": {
              "subject_ref": {
                "$ref": "#/components/schemas/Ref"
              },
              "grant_changes_ref": {
                "$ref": "#/components/schemas/Ref"
              }
            },
            "required": [
              "subject_ref",
              "grant_changes_ref"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schema_version",
          "target",
          "expected_versions",
          "payload"
        ],
        "additionalProperties": false
      },
      "ProgrammeCreateCommand": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": "1"
          },
          "target": {
            "$ref": "#/components/schemas/Target"
          },
          "expected_versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ref"
            },
            "maxItems": 1000
          },
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "objective": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "profile_ref": {
                "$ref": "#/components/schemas/Ref"
              },
              "initial_policy_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Ref"
                },
                "maxItems": 1000
              },
              "budget_ceiling": {
                "$ref": "#/components/schemas/BudgetCeiling"
              }
            },
            "required": [
