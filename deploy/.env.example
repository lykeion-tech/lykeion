# Copy to the VPS as ~/lykeion/.env (mode 600). Never commit the real file.
DOMAIN=app.lykeion.tech

# openssl rand -hex 24
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=
# openssl rand -base64 32
JWT_SECRET=
LYK_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_ADDR=smtp.hostinger.com:587
SMTP_FROM=noreply@lykeion.tech
SMTP_USER=noreply@lykeion.tech
SMTP_PASS=

# Nightly backup to Cloudflare R2, encrypted with age (public key only here)
BACKUP_AGE_RECIPIENT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
R2_BUCKET=lykeion-backups
# Where a failed backup is reported (uses the SMTP account above)
ALERT_EMAIL=

# Optional
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=
OPENALEX_API_KEY=
CONTACT_EMAIL=
