    },
    "hypotheses": {
      "phases": [["demo-hypotheses-author"]],
      "reviewer": "demo-hypotheses-reviewer",
      "kinds": { "notes": { "roles": ["demo-hypotheses-author"] } }
    },
    "experimentation": {
      "phases": [["demo-experimentation-author"]],
      "reviewer": "demo-experimentation-reviewer",
      "kinds": { "notes": { "roles": ["demo-experimentation-author"] } }
    },
    "validation": {
      "phases": [["demo-validation-author"]],
      "reviewer": "demo-validation-reviewer",
      "kinds": { "notes": { "roles": ["demo-validation-author"] } }
    },
    "reporting": {
      "phases": [["demo-reporting-author"]],
      "reviewer": "demo-reporting-reviewer",
      "kinds": { "notes": { "roles": ["demo-reporting-author"] } }
    }
