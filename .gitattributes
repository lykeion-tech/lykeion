# Preserve accessibility captures verbatim as reference evidence.
research/visual-baseline/**/*.ax.txt -whitespace

# Third-party skill text (K-Dense, MIT); not Lykeion code.
server/internal/science/bundle/** linguist-vendored

# Embedded bytes must match the sizes in index.json.
server/internal/workflow/bundle/** -text

# Python, R and Lean files are workflow material and helper scripts, not the
# languages Lykeion is written in; keep them out of GitHub's language stats.
*.py linguist-detectable=false
*.lean linguist-detectable=false
*.R linguist-detectable=false
*.r linguist-detectable=false
*.Rmd linguist-detectable=false
